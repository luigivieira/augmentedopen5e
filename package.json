{
  "name": "augmentedopen5e",
  "type": "module",
  "version": "1.0.0",
  "description": "An Azion Edge Functions API to augment Open5e 5th Edition SRD content with automatic LLM translations.",
  "main": "index.ts",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --coverage --ui",
    "emulate": "dotenv -e .env.local -- azion dev",
    "open": "pnpm dlx open-cli http://localhost:3333/",
    "build:staging": "AZION_ENV=staging azion build --config-dir azion/staging",
    "build:prod": "AZION_ENV=production azion build --config-dir azion/production",
    "reset": "node scripts/reset-azion-state.js",
    "delete:cache:staging": "node scripts/reset-cache.js staging",
    "delete:cache:prod": "node scripts/reset-cache.js production",
    "deploy:staging": "pnpm build:staging && AZION_ENV=staging azion deploy --local --config-dir azion/staging --skip-build -y",
    "deploy:prod": "pnpm build:prod && AZION_ENV=production azion deploy --local --config-dir azion/production --skip-build -y"
  },
  "keywords": [
    "azion",
    "edge",
    "functions",
    "open5e",
    "dnd",
    "5e",
    "api",
    "llm",
    "translation"
  ],
  "author": "Vieira",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "azion": "^3.1.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
